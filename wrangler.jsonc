{
  // Configuracion del Worker que publica coatzadrone.cl.
  //
  // El secreto BREVO_API_KEY no va aqui. Se define en el panel:
  // Workers & Pages -> coatzadrone-cl -> Settings -> Variables and Secrets.
  // Tampoco van aqui ADMIN_CLAVE (la clave del panel /admin) ni
  // TURNSTILE_SECRET (la verificacion anti-robots). Mismo sitio, tipo Secret.
  "name": "coatzadrone-cl",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",

    // Todo pasa por worker/index.js antes de servirse: lo necesita el aviso de
    // mantenimiento. Pendiente: pasar a una lista de rutas para que CSS, JS e
    // imagenes no cuenten en las 100.000 solicitudes diarias del plan gratis.
    // El 23 de septiembre la lista hizo fallar el despliegue en Workers Builds;
    // ver CLAUDE.md antes de reintentarlo.
    "run_worker_first": true
  },

  // Almacen del catalogo: cursos, instructores e imagenes que se editan en
  // /admin. Ver docs/PANEL.md.
  //
  // El id no es un secreto: solo identifica el almacen dentro de la cuenta, y
  // sin acceso a la cuenta no sirve de nada. Por eso puede vivir en este
  // archivo, que es publico.
  "kv_namespaces": [
    { "binding": "CONFIG", "id": "422c3bb42b924dbc97c354b861001e11" }
  ],

  // Limites de intentos por IP, usados en worker/proteccion.js. El namespace_id
  // es un numero cualquiera, unico dentro de la cuenta de Cloudflare.
  "ratelimits": [
    // Formulario y banner: 5 envios por minuto. Frena a quien lo dispara en
    // serie para mandar correos con nuestro remitente.
    { "name": "LIMITE_FORMULARIO", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // Panel: 20 solicitudes por minuto. Frena a quien prueba claves.
    { "name": "LIMITE_PANEL", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],

  // Registro de errores en Workers Logs (Cloudflare -> coatzadrone-cl ->
  // Observability). Solo guarda lo que el codigo registra a proposito, buscable
  // por el campo "evento". invocation_logs en false: no se guarda cada visita
  // con sus cabeceras, porque una de ellas lleva la clave del panel.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
