# Cabeceras para Cloudflare Pages
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# CSS y JS: revalidar siempre. Este sitio no tiene build que agregue hashes a los
# nombres de archivo, asi que una cache larga dejaria a los visitantes recurrentes
# con la version vieja. Con must-revalidate el navegador pregunta y recibe un 304
# si nada cambio, por lo que el costo es practicamente cero.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Imagenes: cambian rara vez. Un dia es buen equilibrio entre velocidad y poder
# reemplazar una foto sin esperar semanas.
/assets/img/*
  Cache-Control: public, max-age=86400

/data/*.json
  Cache-Control: public, max-age=300, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
